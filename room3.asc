// room script file

function room_FirstLoad()
{
oLamp.SetView(7);
oLamp.Animate(0, 20, eRepeat, eNoBlock);

oClock.SetView(8);
oClock.Animate(0, 40, eRepeat, eNoBlock);

oCroissant.SetView(9);
oCroissant.Animate(0, 15, eRepeat, eNoBlock);

oCoffee.SetView(10);
oCoffee.Animate(0, 15, eRepeat, eNoBlock);

oCandle.SetView(11);
oCandle.Animate(0, 15, eRepeat, eNoBlock);

oCandle2.SetView(12);
oCandle2.Animate(0, 15, eRepeat, eNoBlock);
}

function oCoffee_PickUp(Object *theObject, CursorMode mode) // oObject should be the object you're attempting to pick up.
{
  WalkToObjectAndPickup(theObject);
  player.AddInventory(iCoffee); //this is where you'd add the item to your inventory, since the global script won't do that.
}

